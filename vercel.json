{
    "version": 2,
    "builds": [
      { "src": "frontend/package.json", "use": "@vercel/next" },
      { 
        "src": "api/app.py",
        "use": "@vercel/python",
        "config": {
          "runtime": "python3.11",
          "maxLambdaSize": "15mb"
        }
      }
    ],
    "routes": [
      { 
        "src": "/api/(.*)", 
        "dest": "api/app.py"
      },
      { 
        "src": "/(.*)", 
        "dest": "frontend/$1"
      }
    ],
    "functions": {
      "api/app.py": {
        "maxDuration": 30
      }
    }
  } 